        "accounts_kind": {
          "name": "accounts_kind",
          "value": "\"accounts\".\"kind\" IN ('cash', 'credit', 'tracking')"
        },
        "accounts_currency": {
          "name": "accounts_currency",
          "value": "\"accounts\".\"currency\" = 'USD'"
        },
        "accounts_opening": {
          "name": "accounts_opening",
          "value": "(\"accounts\".\"kind\" = 'tracking' AND \"accounts\".\"opening_cents\" IS NULL AND \"accounts\".\"opening_date\" IS NULL) OR (\"accounts\".\"kind\" IN ('cash', 'credit') AND \"accounts\".\"opening_cents\" IS NOT NULL AND \"accounts\".\"opening_date\" IS NOT NULL)"
        },
        "accounts_cents": {
          "name": "accounts_cents",
          "value": "\"accounts\".\"opening_cents\" IS NULL OR (typeof(\"accounts\".\"opening_cents\") = 'integer' AND \"accounts\".\"opening_cents\" BETWEEN -9007199254740991 AND 9007199254740991)"
        },
        "accounts_revision": {
          "name": "accounts_revision",
          "value": "typeof(\"accounts\".\"revision\") = 'integer' AND \"accounts\".\"revision\" BETWEEN 1 AND 9007199254740991"
        }
      }
