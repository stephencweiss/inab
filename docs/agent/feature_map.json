        {
          "command": "node --import tsx src/cli/main.ts",
          "args": ["--db", "${database}", "register", "${accountId}", "--json"],
          "promptAnswers": [],
          "exitStatus": 0,
          "captureAccount": false,
          "captureTransaction": false,
          "stdoutContains": [
            "\"clearance\":\"reconciled\"",
            "\"clearance\":\"uncleared\"",
            "\"unclearedCents\":-6000"
          ],
          "stderrContains": []
        },
        {
          "command": "node --import tsx src/cli/main.ts",
          "args": [
            "--db",
            "${database}",
            "reconciliation",
            "list",
            "--account",
            "${accountId}",
            "--json"
          ],
          "promptAnswers": [],
          "exitStatus": 0,
          "captureAccount": false,
          "captureTransaction": false,
          "stdoutContains": [
            "\"status\":\"valid\"",
            "\"transactionRevision\":1",
            "\"openingCents\":100000",
            "\"openingDate\":\"2026-10-16\""
          ],
          "stderrContains": []
