{
  "version": 1,
  "workflows": [
    {
      "id": "terminal.accounts.manage",
      "name": "Create, inspect, rename, and correct a local account",
      "prerequisites": [
        "Use a new temporary directory and an absent database path inside it. All names and amounts below are synthetic.",
        "Run each command from the repository root with Node.js 24.16.0 and installed dependencies. The test uses the same entry point from the temporary directory.",
        "Replace ${database} with the temporary database path. Capture ${accountId} and ${revision} from the account object in the JSON output when captureAccount is true.",
        "Commands use explicit flags and require no prompt answers. Delete the temporary directory after the workflow."
      ],
      "sourceFiles": [
        "src/cli/main.ts",
        "src/cli/parse.ts",
        "src/cli/prompts.ts",
        "src/cli/render.ts",
        "src/bootstrap.ts",
        "src/application/accounts.ts",
        "src/application/ports.ts",
        "src/storage/accounts.ts",
        "src/storage/rows.ts"
      ],
      "steps": [
        {
          "command": "node --import tsx src/cli/main.ts",
          "args": ["--db", "${database}", "init", "--confirm", "--json"],
          "promptAnswers": [],
          "exitStatus": 0,
          "captureAccount": false,
          "stdoutContains": ["\"ok\":true", "\"schemaVersion\":2"],
          "stderrContains": []
        },
        {
          "command": "node --import tsx src/cli/main.ts",
          "args": [
            "--db",
            "${database}",
            "account",
            "add",
            "--name",
            "Synthetic cash",
            "--kind",
            "cash",
            "--opening",
            "123.45",
            "--as-of",
            "2026-10-16",
            "--confirm",
            "--json"
          ],
          "promptAnswers": [],
          "exitStatus": 0,
          "captureAccount": true,
          "stdoutContains": ["\"openingCents\":12345", "\"revision\":1"],
          "stderrContains": []
        },
        {
          "command": "node --import tsx src/cli/main.ts",
          "args": ["--db", "${database}", "account", "list", "--json"],
          "promptAnswers": [],
          "exitStatus": 0,
          "captureAccount": false,
          "stdoutContains": ["${accountId}", "Synthetic cash"],
          "stderrContains": []
        },
        {
          "command": "node --import tsx src/cli/main.ts",
          "args": ["--db", "${database}", "account", "show", "${accountId}", "--json"],
          "promptAnswers": [],
          "exitStatus": 0,
          "captureAccount": false,
          "stdoutContains": ["${accountId}", "\"workingCents\":12345"],
          "stderrContains": []
        },
        {
          "command": "node --import tsx src/cli/main.ts",
          "args": [
            "--db",
            "${database}",
            "account",
            "rename",
            "${accountId}",
            "--name",
            "Synthetic renamed",
            "--expected-version",
            "${revision}",
            "--confirm",
            "--json"
          ],
          "promptAnswers": [],
          "exitStatus": 0,
          "captureAccount": true,
          "stdoutContains": ["${accountId}", "Synthetic renamed", "\"revision\":2"],
          "stderrContains": []
        },
        {
          "command": "node --import tsx src/cli/main.ts",
          "args": [
            "--db",
            "${database}",
            "account",
            "opening",
            "${accountId}",
            "--amount",
            "-12.34",
            "--as-of",
            "2026-10-15",
            "--expected-version",
            "1",
            "--confirm",
            "--json"
          ],
          "promptAnswers": [],
          "exitStatus": 4,
          "captureAccount": false,
          "stdoutContains": [],
          "stderrContains": ["stale-version"]
        },
        {
          "command": "node --import tsx src/cli/main.ts",
          "args": [
            "--db",
            "${database}",
            "account",
            "opening",
            "${accountId}",
            "--amount",
            "-12.34",
            "--as-of",
            "2026-10-15",
            "--expected-version",
            "${revision}",
            "--confirm",
            "--json"
          ],
          "promptAnswers": [],
          "exitStatus": 0,
          "captureAccount": true,
          "stdoutContains": [
            "${accountId}",
            "\"openingCents\":-1234",
            "\"openingDate\":\"2026-10-15\"",
            "\"revision\":3"
          ],
          "stderrContains": []
        },
        {
          "command": "node --import tsx src/cli/main.ts",
          "args": ["--db", "${database}", "account", "show", "missing-synthetic-id", "--json"],
          "promptAnswers": [],
          "exitStatus": 3,
          "captureAccount": false,
          "stdoutContains": [],
          "stderrContains": ["account-unavailable"]
        },
        {
          "command": "node --import tsx src/cli/main.ts",
          "args": [
            "--db",
            "${database}",
            "account",
            "add",
            "--name",
            "Invalid synthetic",
            "--kind",
            "cash",
            "--opening",
            "0",
            "--as-of",
            "2026-02-30",
            "--confirm",
            "--json"
          ],
          "promptAnswers": [],
          "exitStatus": 2,
          "captureAccount": false,
          "stdoutContains": [],
          "stderrContains": ["invalid-account"]
        }
      ]
    },
    {
      "id": "terminal.transactions.manage",
      "name": "Record, correct, and clear manual purchases",
      "prerequisites": [
        "Use a new temporary database and synthetic values only.",
        "Capture transactionId and transactionRevision from transaction JSON when captureTransaction is true.",
        "Use accountId from the account JSON. Confirm each script write."
      ],
      "sourceFiles": [
        "src/cli/transactions.ts",
        "src/cli/parse.ts",
        "src/cli/prompts.ts",
        "src/application/transactions.ts",
        "src/storage/transactions.ts"
      ],
      "steps": [
        {
          "command": "node --import tsx src/cli/main.ts",
          "args": ["--db", "${database}", "init", "--confirm", "--json"],
          "promptAnswers": [],
          "exitStatus": 0,
          "captureAccount": false,
          "captureTransaction": false,
          "stdoutContains": ["\"ok\":true"],
          "stderrContains": []
        },
        {
          "command": "node --import tsx src/cli/main.ts",
          "args": [
            "--db",
            "${database}",
            "account",
            "add",
            "--name",
            "Synthetic transaction cash",
            "--kind",
            "cash",
            "--opening",
            "1000",
            "--as-of",
            "2026-10-16",
            "--confirm",
            "--json"
          ],
          "promptAnswers": [],
          "exitStatus": 0,
          "captureAccount": true,
          "captureTransaction": false,
          "stdoutContains": ["\"openingCents\":100000"],
          "stderrContains": []
        },
        {
          "command": "node --import tsx src/cli/main.ts",
          "args": [
            "--db",
            "${database}",
            "transaction",
            "add",
            "--account",
            "${accountId}",
            "--date",
            "2026-10-15",
            "--amount",
            "-60",
            "--payee",
            "Synthetic pending shop",
            "--confirm",
            "--json"
          ],
          "promptAnswers": [],
          "exitStatus": 0,
          "captureAccount": false,
          "captureTransaction": true,
          "stdoutContains": ["\"postedOn\":null", "\"revision\":1"],
          "stderrContains": []
        },
        {
          "command": "node --import tsx src/cli/main.ts",
          "args": [
            "--db",
            "${database}",
            "transaction",
            "add",
            "--account",
            "${accountId}",
            "--date",
            "2026-10-17",
            "--amount",
            "-25",
            "--payee",
            "Synthetic posted shop",
            "--posted-on",
            "2026-10-17",
            "--confirm",
            "--json"
          ],
          "promptAnswers": [],
          "exitStatus": 0,
          "captureAccount": false,
          "captureTransaction": false,
          "stdoutContains": ["\"cents\":-2500"],
          "stderrContains": []
        },
        {
          "command": "node --import tsx src/cli/main.ts",
          "args": ["--db", "${database}", "register", "${accountId}", "--json"],
          "promptAnswers": [],
          "exitStatus": 0,
          "captureAccount": false,
          "captureTransaction": false,
          "stdoutContains": [
            "\"workingCents\":91500",
            "\"clearedCents\":97500",
            "\"unclearedCents\":-6000",
            "${transactionId}"
          ],
          "stderrContains": []
        },
        {
          "command": "node --import tsx src/cli/main.ts",
          "args": [
            "--db",
            "${database}",
            "transaction",
            "clear",
            "${transactionId}",
            "--posted-on",
            "2026-10-16",
            "--expected-version",
            "${transactionRevision}",
            "--confirm",
            "--json"
          ],
          "promptAnswers": [],
          "exitStatus": 2,
          "captureAccount": false,
          "captureTransaction": false,
          "stdoutContains": [],
          "stderrContains": ["posting-in-opening-period"]
        },
        {
          "command": "node --import tsx src/cli/main.ts",
          "args": [
            "--db",
            "${database}",
            "transaction",
            "clear",
            "${transactionId}",
            "--posted-on",
            "2026-10-17",
            "--expected-version",
            "${transactionRevision}",
            "--confirm",
            "--json"
          ],
          "promptAnswers": [],
          "exitStatus": 0,
          "captureAccount": false,
          "captureTransaction": true,
          "stdoutContains": ["${transactionId}", "\"revision\":2"],
          "stderrContains": []
        },
        {
          "command": "node --import tsx src/cli/main.ts",
          "args": [
            "--db",
            "${database}",
            "transaction",
            "edit",
            "${transactionId}",
            "--date",
            "2026-10-15",
            "--amount",
            "-55",
            "--payee",
            "Synthetic corrected shop",
            "--memo",
            "",
            "--expected-version",
            "${transactionRevision}",
            "--confirm",
            "--json"
          ],
          "promptAnswers": [],
          "exitStatus": 0,
          "captureAccount": false,
          "captureTransaction": true,
          "stdoutContains": ["${transactionId}", "\"postedOn\":\"2026-10-17\"", "\"revision\":3"],
          "stderrContains": []
        },
        {
          "command": "node --import tsx src/cli/main.ts",
          "args": [
            "--db",
            "${database}",
            "transaction",
            "unclear",
            "${transactionId}",
            "--expected-version",
            "${transactionRevision}",
            "--confirm",
            "--json"
          ],
          "promptAnswers": [],
          "exitStatus": 0,
          "captureAccount": false,
          "captureTransaction": true,
          "stdoutContains": ["${transactionId}", "\"postedOn\":null", "\"revision\":4"],
          "stderrContains": []
        },
        {
          "command": "node --import tsx src/cli/main.ts",
          "args": ["--db", "${database}", "register", "${accountId}", "--json"],
          "promptAnswers": [],
          "exitStatus": 0,
          "captureAccount": false,
          "captureTransaction": false,
          "stdoutContains": [
            "\"workingCents\":92000",
            "\"clearedCents\":97500",
            "\"unclearedCents\":-5500"
          ],
          "stderrContains": []
        },
        {
          "command": "node --import tsx src/cli/main.ts",
          "args": [
            "--db",
            "${database}",
            "transaction",
            "unclear",
            "${transactionId}",
            "--expected-version",
            "1",
            "--confirm",
            "--json"
          ],
          "promptAnswers": [],
          "exitStatus": 4,
          "captureAccount": false,
          "captureTransaction": false,
          "stdoutContains": [],
          "stderrContains": ["stale-version"]
        }
      ]
    },
    {
      "id": "terminal.reconciliation.compare",
      "name": "Compare posted bank balances and preserve reconciliation evidence",
      "prerequisites": [
        "Use a new temporary database and the synthetic running example only.",
        "Capture accountId from account JSON and transactionId/transactionRevision from the posted purchase JSON.",
        "Use explicit dates and confirmation flags. Mismatch writes no reconciliation or adjustment.",
        "Metadata-only correction keeps coverage; the original evidence revision stays 1."
      ],
      "sourceFiles": [
        "src/cli/reconciliation.ts",
        "src/cli/parse.ts",
        "src/cli/prompts.ts",
        "src/application/reconcile.ts",
        "src/accounts/reconciliation.ts",
        "src/storage/reconciliations.ts",
        "src/application/transactions.ts"
      ],
      "steps": [
        {
          "command": "node --import tsx src/cli/main.ts",
          "args": ["--db", "${database}", "init", "--confirm", "--json"],
          "promptAnswers": [],
          "exitStatus": 0,
          "captureAccount": false,
          "captureTransaction": false,
          "stdoutContains": ["\"ok\":true"],
          "stderrContains": []
        },
        {
          "command": "node --import tsx src/cli/main.ts",
          "args": [
            "--db",
            "${database}",
            "account",
            "add",
            "--name",
            "Synthetic transaction cash",
            "--kind",
            "cash",
            "--opening",
            "1000",
            "--as-of",
            "2026-10-16",
            "--confirm",
            "--json"
          ],
          "promptAnswers": [],
          "exitStatus": 0,
          "captureAccount": true,
          "captureTransaction": false,
          "stdoutContains": ["\"openingCents\":100000"],
          "stderrContains": []
        },
        {
          "command": "node --import tsx src/cli/main.ts",
          "args": [
            "--db",
            "${database}",
            "transaction",
            "add",
            "--account",
            "${accountId}",
            "--date",
            "2026-10-15",
            "--amount",
            "-60",
            "--payee",
            "Synthetic pending shop",
            "--confirm",
            "--json"
          ],
          "promptAnswers": [],
          "exitStatus": 0,
          "captureAccount": false,
          "captureTransaction": true,
          "stdoutContains": ["\"postedOn\":null", "\"revision\":1"],
          "stderrContains": []
        },
        {
          "command": "node --import tsx src/cli/main.ts",
          "args": [
            "--db",
            "${database}",
            "transaction",
            "add",
            "--account",
            "${accountId}",
            "--date",
            "2026-10-17",
            "--amount",
            "-25",
            "--payee",
            "Synthetic posted shop",
            "--posted-on",
            "2026-10-17",
            "--confirm",
            "--json"
          ],
          "promptAnswers": [],
          "exitStatus": 0,
          "captureAccount": false,
          "captureTransaction": true,
          "stdoutContains": ["\"cents\":-2500"],
          "stderrContains": []
        },
        {
          "command": "node --import tsx src/cli/main.ts",
          "args": ["--db", "${database}", "register", "${accountId}", "--json"],
          "promptAnswers": [],
          "exitStatus": 0,
          "captureAccount": false,
          "captureTransaction": false,
          "stdoutContains": [
            "\"workingCents\":91500",
            "\"clearedCents\":97500",
            "\"unclearedCents\":-6000",
            "${transactionId}"
          ],
          "stderrContains": []
        },
        {
          "command": "node --import tsx src/cli/main.ts",
          "args": [
            "--db",
            "${database}",
            "reconcile",
            "${accountId}",
            "--as-of",
            "2026-10-17",
            "--bank-balance",
            "970",
            "--confirm",
            "--json"
          ],
          "promptAnswers": [],
          "exitStatus": 4,
          "captureAccount": false,
          "captureTransaction": false,
          "stdoutContains": ["\"computedCents\":97500", "\"differenceCents\":-500"],
          "stderrContains": ["balance-mismatch"]
        },
        {
          "command": "node --import tsx src/cli/main.ts",
          "args": [
            "--db",
            "${database}",
            "reconciliation",
            "list",
            "--account",
            "${accountId}",
            "--json"
          ],
          "promptAnswers": [],
          "exitStatus": 0,
          "captureAccount": false,
          "captureTransaction": false,
          "stdoutContains": ["\"reconciliations\":[]"],
          "stderrContains": []
        },
        {
          "command": "node --import tsx src/cli/main.ts",
          "args": [
            "--db",
            "${database}",
            "reconcile",
            "${accountId}",
            "--as-of",
            "2026-10-17",
            "--bank-balance",
            "975",
            "--confirm",
            "--json"
          ],
          "promptAnswers": [],
