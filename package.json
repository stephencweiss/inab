{
  "name": "inab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "scripts": {
    "check:documents": "tsx scripts/check-documents.ts",
    "check:tracked": "tsx scripts/check-tracked-paths.ts",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "check:format": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:quick": "npm run check:documents && npm run check:tracked -- --staged && npm run check:secrets -- --staged && npm run lint",
    "check": "tsx scripts/check.ts",
    "prepare": "husky",
    "inab": "tsx src/cli/main.ts",
    "build": "tsc -p tsconfig.build.json && tsx scripts/copy-migrations.ts",
    "check:boundaries": "tsx scripts/check-boundaries.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/cli/migrate.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "prettier": "3.9.10",
    "secretlint": "13.0.7",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4"
  }
}
